# ==============================================================================
# MediNexus Spring Boot Environment Template
# Copy this file to .env or set environment variables in your environment
# DO NOT COMMIT REAL CREDENTIALS
# ==============================================================================

PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/student_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_hex_at_least_256_bits
JWT_EXPIRATION_MS=604800000
